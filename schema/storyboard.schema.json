{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heritage-short/storyboard",
  "title": "Heritage Short storyboard: the contract between every stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "version", "logline", "consent", "style", "references", "voice", "music", "render", "mix", "shots"],
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "seeds"],
      "properties": {
        "prompt": {"type": "string", "minLength": 20},
        "seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1, "maxItems": 8},
        "chosen_seed": {"type": ["integer", "null"], "description": "The approved candidate (golden reference); null = not chosen yet"}
      }
    },
    "size": {"type": "array", "items": {"type": "integer", "minimum": 128, "maximum": 3840}, "minItems": 2, "maxItems": 2}
  },
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "language": {"const": "am", "description": "Narration language (Amharic)"},
    "version": {"type": "integer", "minimum": 1, "description": "Bump when audience feedback changes the storyboard"},
    "logline": {"type": "string", "minLength": 10},
    "changelog": {"type": "array", "items": {"type": "string"}, "description": "What changed in each version and why"},
    "consent": {
      "type": "object", "additionalProperties": false,
      "required": ["likeness_approved", "script_approved"],
      "properties": {
        "likeness_approved": {"type": "boolean", "description": "Mother consented to an AI likeness (recorded in ETHICS.md)"},
        "script_approved": {"type": "boolean", "description": "Mother approved the narration words"},
        "note": {"type": "string"}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["style_block", "character_block", "use_style_reference", "image_size"],
      "properties": {
        "style_block": {"type": "string", "minLength": 10, "description": "Appended to every image prompt"},
        "character_block": {"type": "string", "minLength": 10, "description": "Appended when a shot shows the mother (only with consent)"},
        "use_style_reference": {"type": "boolean", "description": "Pass the chosen style reference image to every keyframe"},
        "image_size": {"$ref": "#/$defs/size"}
      }
    },
    "references": {
      "type": "object", "additionalProperties": false,
      "required": ["style", "character"],
      "properties": {
        "style": {"$ref": "#/$defs/reference"},
        "character": {"$ref": "#/$defs/reference"}
      }
    },
    "voice": {
      "type": "object", "additionalProperties": false,
      "required": ["voice", "style", "max_pause_s"],
      "properties": {
        "voice": {"type": "string", "minLength": 2, "description": "Stock Gemini TTS voice name; never a cloned voice"},
        "style": {"type": "string", "minLength": 5},
        "max_pause_s": {"type": "number", "minimum": 0.15, "maximum": 2, "description": "Pauses inside a line are shortened to this (no model call)"}
      }
    },
    "music": {
      "type": "object", "additionalProperties": false,
      "required": ["caption", "bpm", "keyscale", "duration_s", "seeds"],
      "properties": {
        "caption": {"type": "string", "minLength": 10, "maxLength": 512},
        "bpm": {"type": "integer", "minimum": 30, "maximum": 300},
        "keyscale": {"type": "string"},
        "duration_s": {"type": "number", "minimum": 10, "maximum": 240},
        "seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 1, "maxItems": 8},
        "chosen_seed": {"type": ["integer", "null"]},
        "choice_reason": {"type": "string"}
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "required": ["fps", "lead_in_s", "transition_s", "end_card_s", "end_card_lines", "sizes"],
      "properties": {
        "fps": {"type": "integer", "enum": [24, 25, 30]},
        "lead_in_s": {"type": "number", "minimum": 0, "maximum": 2, "description": "Silence before each shot's narration"},
        "transition_s": {"type": "number", "minimum": 0, "maximum": 1.5, "description": "Crossfade between shots"},
        "end_card_s": {"type": "number", "minimum": 2, "maximum": 5},
        "end_card_lines": {"type": "array", "items": {"type": "string", "maxLength": 48}, "minItems": 1, "maxItems": 5},
        "sizes": {
          "type": "object", "additionalProperties": false, "required": ["vertical", "horizontal"],
          "properties": {"vertical": {"$ref": "#/$defs/size"}, "horizontal": {"$ref": "#/$defs/size"}}
        }
      }
    },
    "mix": {
      "type": "object", "additionalProperties": false,
      "required": ["music_gain_db", "duck_threshold", "duck_ratio", "duck_attack_ms", "duck_release_ms", "target_lufs", "true_peak_db"],
      "properties": {
        "music_gain_db": {"type": "number", "minimum": -40, "maximum": 0},
        "duck_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "duck_ratio": {"type": "number", "minimum": 1, "maximum": 20},
        "duck_attack_ms": {"type": "number", "minimum": 1, "maximum": 2000},
        "duck_release_ms": {"type": "number", "minimum": 10, "maximum": 9000},
        "pre_limiter_db": {"type": ["number", "null"], "minimum": -20, "maximum": 0, "description": "Peak limit on the mix before loudnorm (dBFS); null = off"},
        "target_lufs": {"type": "number", "minimum": -30, "maximum": -8},
        "true_peak_db": {"type": "number", "minimum": -9, "maximum": 0}
      }
    },
    "shots": {
      "type": "array", "minItems": 8, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "duration_s", "reason", "shot_size", "character", "image_prompt",
                     "motion_prompt", "seed", "narration", "music_cue", "kenburns", "video"],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "duration_s": {"type": "number", "minimum": 4, "maximum": 12, "description": "Planned length; stretched if the narration is longer"},
          "reason": {"type": "string", "minLength": 15, "description": "Why this shot exists: story job and feeling"},
          "shot_size": {"enum": ["extreme wide", "wide", "medium", "medium close-up", "close-up", "extreme close-up", "insert"]},
          "character": {"type": "boolean", "description": "true = the mother is visible; needs consent, else no_face_prompt is used"},
          "image_prompt": {"type": "string", "minLength": 20},
          "no_face_prompt": {"type": "string", "minLength": 20, "description": "Used instead of image_prompt while likeness consent is missing"},
          "motion_prompt": {"type": "string", "minLength": 5, "description": "Motion and camera only, for Wan image-to-video"},
          "seed": {"type": "integer", "minimum": 0},
          "narration": {
            "type": "object", "additionalProperties": false, "required": ["am", "en"],
            "properties": {
              "am": {"type": "string", "minLength": 3, "description": "Amharic narration (spoken)"},
              "en": {"type": "string", "minLength": 3, "description": "English subtitle text"}
            }
          },
          "music_cue": {"type": "string"},
          "kenburns": {"enum": ["in", "out", "left", "right", "up", "down"]},
          "video": {"enum": ["kenburns", "wan"], "description": "wan = use a Kaggle clip when one exists for the current keyframe"}
        }
      }
    }
  }
}
