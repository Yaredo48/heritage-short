# Copy to .env and fill in. .env is git-ignored; never commit keys.
# Gemini API key from Google AI Studio (free tier): narration (TTS) and the script stage.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACK=gemini-3.8-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Cloudflare Workers AI (free daily allowance): keyframes with FLUX.2 klein 4B.
# Token needs the "Workers AI" permission only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
